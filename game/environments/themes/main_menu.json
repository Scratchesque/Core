{
  "#fira_code_font": {
    "font": {
      "name": "custom_font",
      "size": "14",
      "regular_resource": {
        "package": "game.assets.fonts",
        "resource": "FiraCode-Regular.ttf"
      },
      "bold_resource": {
        "package": "game.assets.fonts",
        "resource": "FiraCode-Bold.ttf"
      }
    }
  },
  "#sprout_lands_font":{
    "font": {
      "name": "pixel_font",
      "regular_resource": {
        "package": "game.assets.fonts",
        "resource": "SproutLands-PixelFont.ttf"
      }
    }
  },
  "label":{
    "font": {
      "name": "custom_font",
      "size":"18",
      "bold": "1"
    },
    "colours": {
      "normal_text": "#FFF9E8"
    }
  },
  "button":{
    "font": {
      "name": "pixel_font",
      "size":"18",
      "bold": "1"
    },
    "colours": {
      "normal_text": "#2F2412",
      "active_text": "#9F9F9F"
    }
  },
  "#transparent": {
    "colours": {
      "normal_bg": "#00000000",
      "dark_bg": "#00000000",
      "hovered_bg": "#00000000",
      "active_bg": "#00000000",
      "normal_border": "#00000000",
      "hovered_border": "#00000000",
      "active_border": "#00000000"
    },
    "misc": {
      "shadow_width": "0"
    }
  },
  "#menu_subtitle": {
    "parent": "label",
    "colours": {
      "normal_text": "#2F2412"
    }
  },
  "#menu_image_button": {
    "prototype": "#transparent",
    "parent":"button"
  },
  "#dialogue_panel": {
    "colours": {
      "dark_bg": "#FFF6D8",
      "normal_border": "#D1B97A"
    },
    "misc": {
      "shape": "rounded_rectangle",
      "shape_corner_radius": "18",
      "border_width": "3",
      "shadow_width": "0"
    }
  },
  "#dialogue_panel.#title": {
    "font": {
      "name": "custom_font",
      "size": "22",
      "bold": "1"
    },
    "colours": {
      "normal_text": "#2E2E2E"
    }
  },
  "#dialogue_panel.#body": {
    "prototype": "#transparent",
    "font": {
      "name": "custom_font",
      "size": "18",
      "bold": "0"
    },
    "colours": {
      "normal_text": "#4A3A1C"
    }
  },
  "#dialogue_panel.#button": {
    "prototype": "#transparent",
    "parent": "button"
  }
}
